# Keep deployment scripts portable across Windows and Linux checkouts.
deploy/*.sh text eol=lf
tools/ops/*.sh text eol=lf
deploy/nginx/*.conf text eol=lf
deploy/*.ps1 text eol=crlf

# Preserve upstream numeric table bytes and reproducible display artifacts.
frontend/prototype/palettes/* text eol=lf
frontend/prototype/data/display-domains.js text eol=lf

# Frozen G3 evidence is hashed byte-for-byte; preserve LF on Windows checkouts.
docs/reports/g3-known-validation-2026-10-26/** text eol=lf

# The August daily audit records the registry byte hash in its snapshot.
docs/data/august-2024-daily-registry.json text eol=lf

# Preserve the exact CRLF bytes registered in the public preferred-month audit receipt.
docs/reports/ocean-candidate-support-verification-2026-11-05.json -text whitespace=cr-at-eol
