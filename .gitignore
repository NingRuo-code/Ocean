# Dependencies and build output
node_modules/
.pnpm-store/
frontend/dist/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.pytest_tmp/
.tmp/

# Local data and generated artifacts
data/raw/*
data/processed/*
data/cache/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
output/

# Local-only AIS/GFW intake workspace
local_data/gfw_ais/downloads/
local_data/gfw_ais/raw/
local_data/gfw_ais/intermediate/
local_data/gfw_ais/authorized_aggregate/

# Server-side data workspaces
server_data/raw/
server_data/intermediate/
server_data/authorized_aggregate/*
!server_data/authorized_aggregate/examples/
!server_data/authorized_aggregate/examples/*.example.json
server_data/logs/

# Reference papers / private project handouts are kept locally
paper/*.pdf
*.docx

# Local configuration
.env
.env.local
.env.*
!.env.example

# Office and review temporary files
~$*
.docx_review/
.questions_render/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db
